<?xml version="1.0" encoding="utf-8"?>
<!--
  NavigationBar icon — Leaderboard tab.
  1-2-3 podium drawn as three columns of different heights on a single
  base: 2nd on the left (medium), 1st in the middle (tallest), 3rd on the
  right (shortest). No fill on the columns — the base line and the empty
  space between columns make the layout read as a podium, not a bar chart.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- 1st place (tallest, center). -->
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.5"
        android:fillColor="@android:color/white"
        android:pathData="M9.75,6.75h4.5a1.5,1.5 0 0 1 1.5,1.5v9.75h-7.5v-9.75a1.5,1.5 0 0 1 1.5,-1.5z" />
    <!-- 2nd place (medium, left). -->
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.5"
        android:fillColor="@android:color/white"
        android:pathData="M3.75,12.75h4.5a1.5,1.5 0 0 1 1.5,1.5v3.75h-7.5v-3.75a1.5,1.5 0 0 1 1.5,-1.5z" />
    <!-- 3rd place (shortest, right). -->
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.5"
        android:fillColor="@android:color/white"
        android:pathData="M15.75,15.75h4.5a1.5,1.5 0 0 1 1.5,1.5v0.75h-7.5v-0.75a1.5,1.5 0 0 1 1.5,-1.5z" />
    <!-- Base / ground line. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M2.25,19.5h19.5a0.75,0.75 0 0 1 0,1.5h-19.5a0.75,0.75 0 0 1 0,-1.5z" />
</vector>
