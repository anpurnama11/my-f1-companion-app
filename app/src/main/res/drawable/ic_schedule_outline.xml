    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Binder ring — left. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M8,2.25a0.75,0.75 0 0 1 0.75,0.75v3a0.75,0.75 0 0 1 -1.5,0v-3a0.75,0.75 0 0 1 0.75,-0.75z" />
    <!-- Binder ring — right. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M16,2.25a0.75,0.75 0 0 1 0.75,0.75v3a0.75,0.75 0 0 1 -1.5,0v-3a0.75,0.75 0 0 1 0.75,-0.75z" />
    <!-- Calendar body (rounded square). -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M5.25,5.25a1.5,1.5 0 0 0 -1.5,1.5v12.75a1.5,1.5 0 0 0 1.5,1.5h13.5a1.5,1.5 0 0 0 1.5,-1.5v-12.75a1.5,1.5 0 0 0 -1.5,-1.5zM3.75,10.5h16.5v9a0,0 0 0 1 0,0h-16.5z" />
    <!-- Date dot (today's session mark). -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M12,16.5m-1.5,0a1.5,1.5 0 1,0 3,0a1.5,1.5 0 1,0 -3,0z" />
