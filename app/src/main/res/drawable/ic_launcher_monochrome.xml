<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon — Android 13+ themed-icon layer (`monochrome`).

  Renders only the stopwatch silhouette (white fill on transparent background)
  centered in the 108dp adaptive-icon canvas. The full-color foreground for
  default and round launcher icons is the WebP at
  `drawable/ic_launcher_foreground.webp`; this vector is the masked fallback
  so themed icons on Android 13+ still read as "F1 app — next session".
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Top crown / button. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M48,22h12v8h-12z" />
    <!-- Side buttons. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M28,30h6v6h-6z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M74,30h6v6h-6z" />
    <!-- Stopwatch face (ring). Drawn as outer disk + inner cutout. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,30 m-26,0 a26,26 0 1,0 52,0 a26,26 0 1,0 -52,0 z" />
    <path
        android:fillColor="#0d0d0d"
        android:pathData="M54,30 m-19,0 a19,19 0 1,0 38,0 a19,19 0 1,0 -38,0 z" />
    <!-- 12 o'clock tick. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M52,15h4v4h-4z" />
    <!-- 6 o'clock tick. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M52,41h4v4h-4z" />
    <!-- 3 o'clock tick. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M74,28h4v4h-4z" />
    <!-- 9 o'clock tick. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M30,28h4v4h-4z" />
</vector>
