<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required for HttpClientFactory's Ktor CIO calls to f1api.dev. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".F1App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.F1app">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.F1app"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              Countdown widget deep link. The widget builds a
              PendingIntent over ACTION_VIEW with
              f1app://round/{year}/{round} (from NextRaceCache);
              this intent filter routes that into MainActivity,
              which parses the URI and pushes Route.RoundDetail
              onto the Homepage backstack. Single-app custom
              scheme — no App Links / autoVerify because there's
              no public web domain to verify against.

              `singleTop` on the activity ensures a widget tap
              while the app is already foregrounded reuses the
              existing instance and fires onNewIntent(), rather
              than spawning a duplicate activity.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="f1app"
                    android:host="round" />
            </intent-filter>
        </activity>

        <!--
          Countdown widget receiver. Sits beside the activity in
          the same <application>; the meta-data binds the receiver
          to the AppWidgetProviderInfo XML in res/xml/.
        -->
        <receiver
            android:name=".widget.countdown.CountdownWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/countdown_widget_info" />
        </receiver>
    </application>

</manifest>
